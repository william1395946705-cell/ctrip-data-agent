{
  "manifest_version": 3,
  "name": "Meituan Controlled Replay Inspector",
  "version": "0.4.0",
  "minimum_chrome_version": "106",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://me.meituan.com/*", "https://eb.meituan.com/*"],
  "action": {"default_popup": "popup.html", "default_title": "美团昨日采集"},
  "background": {"service_worker": "worker.mjs", "type": "module"},
  "description": "授权测试用：被动捕获美团昨日接口，并在人工确认的普通页执行一次只读重放。",
  "devtools_page": "devtools.html"
}
